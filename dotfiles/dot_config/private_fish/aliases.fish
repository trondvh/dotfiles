# LSD / Navigation
alias ls='lsd'
alias l='lsd -l'
alias la='lsd -a'
alias lla='lsd -la'
alias lt='lsd --tree'
alias cat='bat'
alias ..='cd ..'
alias ...='cd ../..'

# Homebrew updates
alias bup='update-brew'
alias bcheck='brew outdated'
alias bclean='brew cleanup'

# Kubernetes
alias k='kubectl'
alias kctx='kubectx'
alias kns='kubens'

# Chezmoi
alias cz='chezmoi'
alias cza='chezmoi apply'
alias czd='chezmoi diff'
alias czu='chezmoi update'
alias cze='chezmoi edit'
alias czcd='chezmoi cd'

# Git
alias gs='git status'
alias gl='git log --oneline --graph --decorate'
alias gd='git diff'
